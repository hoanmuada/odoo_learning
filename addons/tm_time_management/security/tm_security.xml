<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- ================================================================
             MODULE CATEGORY
             ================================================================ -->
        <record model="ir.module.category" id="module_category_time_management">
            <field name="name">Time Management</field>
            <field name="description">Manage employee time tracking and approvals</field>
            <field name="sequence">25</field>
        </record>

        <!-- ================================================================
             SECURITY GROUPS (3 levels)
             ================================================================ -->

        <!-- Level 1: User — can only see own entries -->
        <record id="group_tm_user" model="res.groups">
            <field name="name">User: Own Time Entries</field>
            <field name="category_id" ref="module_category_time_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Level 2: Manager — can see all entries, approve/reject -->
        <record id="group_tm_manager" model="res.groups">
            <field name="name">Manager: All Time Entries</field>
            <field name="category_id" ref="module_category_time_management"/>
            <field name="implied_ids" eval="[(4, ref('tm_time_management.group_tm_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Level 3: Admin — full access + configuration -->
        <record id="group_tm_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_time_management"/>
            <field name="implied_ids" eval="[(4, ref('tm_time_management.group_tm_manager'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- ================================================================
             RECORD RULES
             ================================================================ -->

        <!-- User: see only own entries -->
        <record id="tm_entry_rule_user" model="ir.rule">
            <field name="name">Time Entry: Own entries only</field>
            <field name="model_id" ref="model_tm_time_entry"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_tm_user'))]"/>
        </record>

        <!-- Manager: see all entries -->
        <record id="tm_entry_rule_manager" model="ir.rule">
            <field name="name">Time Entry: All entries</field>
            <field name="model_id" ref="model_tm_time_entry"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_tm_manager'))]"/>
        </record>

        <!-- Multi-company rule -->
        <record id="tm_entry_rule_company" model="ir.rule">
            <field name="name">Time Entry: Multi-company</field>
            <field name="model_id" ref="model_tm_time_entry"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
